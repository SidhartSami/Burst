{
  "manifest_version": 3,
  "name": "Burst Download Manager",
  "version": "2.1.3",
  "description": "Sends magnet links and torrent files to Burst for fast downloading.",
  "icons": {
    "16": "icons/icon16_orange.png",
    "32": "icons/icon32_orange.png",
    "48": "icons/icon48_orange.png",
    "128": "icons/icon128_orange.png"
  },
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "notifications",
    "alarms",
    "downloads",
    "proxy",
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1:59284/*",
    "http://localhost:59284/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16_gray.png",
      "32": "icons/icon32_gray.png",
      "48": "icons/icon48_gray.png",
      "128": "icons/icon128_gray.png"
    },
    "default_title": "Burst Download Manager",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
